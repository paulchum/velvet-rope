[Unit]
Description=Velvet Rope Proxy for OpenAI Secure MCP Tunnel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=velvet
Group=velvet
EnvironmentFile=/etc/velvet/openai-secure-mcp-tunnel.env
ExecStart=/usr/local/bin/velvet-rope-proxy --config /etc/velvet/velvet-config.yaml
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/velvet

[Install]
WantedBy=multi-user.target
