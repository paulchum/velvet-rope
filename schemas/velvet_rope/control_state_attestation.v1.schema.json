        "irreversible_class_max_de_lockout_inspection_certificate_fraction": {
          "pattern": "^(?:0|1)\\.[0-9]{6}$",
          "type": "string"
        },
        "irreversible_class_verdict_certificate_fraction": {
          "pattern": "^(?:0|1)\\.[0-9]{6}$",
          "type": "string"
        },
        "spend_class_actions": {
          "minimum": 0,
          "type": "integer"
        },
        "spend_class_deterministic_budget_certificate_fraction": {
          "pattern": "^(?:0|1)\\.[0-9]{6}$",
          "type": "string"
        }
      },
      "required": [
        "spend_class_actions",
        "spend_class_deterministic_budget_certificate_fraction",
        "irreversible_class_actions",
        "irreversible_class_max_de_lockout_inspection_certificate_fraction",
        "irreversible_class_verdict_certificate_fraction"
