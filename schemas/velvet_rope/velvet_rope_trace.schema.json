{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://velvet.dev/schemas/velvet_rope/velvet_rope_trace.schema.json",
  "title": "Velvet Rope Trace",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "system_name",
    "adapter_name",
    "adapter_version",
    "suite_version",
    "dataset_fingerprint",
    "scenario_id",
    "scenario_fingerprint",
    "query_id",
    "query_text",
    "candidate_actions",
    "admission_decisions",
    "execution_contexts",
    "warrants",
    "seals",
    "final_response",
    "final_response_hash",
    "refused",
    "action_attempted",
    "action_admitted",
    "action_executed",
    "executed_without_warrant",
    "executed_with_posthoc_warrant",
    "hidden_tool_call",
    "unlisted_tool_called",
    "jurisdiction_violation",
    "budget_violation",
    "consent_violation",
    "policy_violation",
    "stale_policy_snapshot_used",
    "stale_budget_snapshot_used",
    "destructive_action_without_review",
    "external_send_without_review",
    "spend_without_budget_authority",
    "mutation_without_replay_seal",
    "false_lockout",
    "certifiable_waste",
    "refinement_required_but_executed",
    "concierge_required_but_bypassed",
    "missing_candidate_actions",
    "missing_admission_decisions",
    "missing_execution_context",
    "missing_warrant",
    "missing_seal",
    "missing_replay",
    "posthoc_provenance_only",
    "auditability_status",
    "auditability_failures",
    "invariant_violations",
    "liability_multiplier",
    "latency_ms",
    "raw_trace_path",
    "trace_hash"
  ],
  "properties": {
    "run_id": { "type": "string", "minLength": 1 },
    "system_name": { "type": "string", "minLength": 1 },
    "adapter_name": { "type": "string", "minLength": 1 },
    "adapter_version": { "type": "string", "minLength": 1 },
    "suite_version": { "type": "string", "minLength": 1 },
    "dataset_fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "scenario_id": { "type": "string", "minLength": 1 },
    "scenario_fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "query_id": { "type": "string", "minLength": 1 },
    "query_text": { "type": "string", "minLength": 1 },
    "candidate_actions": { "type": "array", "items": { "type": "object" } },
    "admission_decisions": { "type": "array", "items": { "type": "object" } },
    "execution_contexts": { "type": "array", "items": { "type": "object" } },
    "warrants": { "type": "array", "items": { "type": "object" } },
    "seals": { "type": "array", "items": { "type": "object" } },
    "final_response": { "type": "string" },
    "final_response_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "refused": { "type": "boolean" },
    "action_attempted": { "type": "boolean" },
    "action_admitted": { "type": "boolean" },
    "action_executed": { "type": "boolean" },
    "executed_without_warrant": { "type": "boolean" },
    "executed_with_posthoc_warrant": { "type": "boolean" },
    "hidden_tool_call": { "type": "boolean" },
    "unlisted_tool_called": { "type": "boolean" },
    "jurisdiction_violation": { "type": "boolean" },
    "budget_violation": { "type": "boolean" },
    "consent_violation": { "type": "boolean" },
    "policy_violation": { "type": "boolean" },
    "stale_policy_snapshot_used": { "type": "boolean" },
    "stale_budget_snapshot_used": { "type": "boolean" },
    "destructive_action_without_review": { "type": "boolean" },
    "external_send_without_review": { "type": "boolean" },
    "spend_without_budget_authority": { "type": "boolean" },
    "mutation_without_replay_seal": { "type": "boolean" },
    "false_lockout": { "type": "boolean" },
    "certifiable_waste": { "type": "boolean" },
    "refinement_required_but_executed": { "type": "boolean" },
    "concierge_required_but_bypassed": { "type": "boolean" },
    "missing_candidate_actions": { "type": "boolean" },
    "missing_admission_decisions": { "type": "boolean" },
    "missing_execution_context": { "type": "boolean" },
    "missing_warrant": { "type": "boolean" },
    "missing_seal": { "type": "boolean" },
    "missing_replay": { "type": "boolean" },
    "posthoc_provenance_only": { "type": "boolean" },
    "auditability_status": { "enum": ["full", "partial", "non_auditable"] },
    "auditability_failures": { "type": "array", "items": { "type": "string" } },
    "invariant_violations": { "type": "array", "items": { "type": "string" } },
    "liability_multiplier": { "type": "number", "minimum": 0 },
    "latency_ms": { "type": "integer", "minimum": 0 },
    "raw_trace_path": { "type": "string", "minLength": 1 },
    "trace_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "failure_card_ids": { "type": "array", "items": { "type": "string" } },
    "result_failure_binding_ids": { "type": "array", "items": { "type": "string" } },
    "research_record": { "type": "object" }
  }
}
