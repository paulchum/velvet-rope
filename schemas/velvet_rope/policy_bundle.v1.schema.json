{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://velvet.dev/schemas/velvet_rope/policy_bundle.v1.schema.json",
  "title": "Velvet Rope Policy Bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "bundle_schema_version",
    "bundle_id",
    "policy_hash",
    "policy_version",
    "tenant_id",
    "environment",
    "created_at",
    "expires_at",
    "policy_chain",
    "policy_files",
    "tool_schema_hashes",
    "approval_rules",
    "data_class_rules",
    "default_unknown_tool_behavior",
    "default_schema_drift_behavior",
    "signing",
    "signature"
  ],
  "properties": {
    "bundle_schema_version": { "const": "velvet.policy_bundle.v1" },
    "bundle_id": { "type": "string", "minLength": 1 },
    "policy_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "policy_version": { "type": "string", "minLength": 1 },
    "tenant_id": { "type": "string", "minLength": 1 },
    "environment": { "enum": ["local", "saas", "vpc", "on_prem"] },
    "created_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "policy_chain": { "type": "string", "minLength": 1 },
    "policy_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "content"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.(?:yaml|yml)$"
          },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "content": { "type": "string" }
        }
      }
    },
    "tool_schema_hashes": {
      "type": "object",
      "additionalProperties": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
    },
    "approval_rules": { "type": "object" },
    "data_class_rules": { "type": "object" },
    "default_unknown_tool_behavior": { "enum": ["block", "escalate"] },
    "default_schema_drift_behavior": { "enum": ["block", "escalate"] },
    "signing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "key_id",
        "provider",
        "signed_at",
        "canonicalization"
      ],
      "properties": {
        "algorithm": { "const": "HMAC-SHA256" },
        "key_id": { "type": "string", "minLength": 1 },
        "provider": { "type": "string", "minLength": 1 },
        "signed_at": { "type": "string", "format": "date-time" },
        "canonicalization": {
          "const": "velvet.policy_bundle.v1.canonical_json.sha256.hmac"
        }
      }
    },
    "signature": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
