{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://velvet.dev/schemas/velvet_rope/liability_warrant.schema.json",
  "title": "Velvet Rope Liability Warrant",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "warrant_id",
    "seal_id",
    "candidate_action_id",
    "decision_id",
    "system_name",
    "adapter_name",
    "adapter_version",
    "pre_execution",
    "posthoc",
    "clearance_score",
    "entry_price",
    "expected_upside",
    "risk_penalty",
    "policy_snapshot_hash",
    "budget_snapshot_hash",
    "jurisdiction_evidence",
    "consent_evidence",
    "authority_scope",
    "tool_allowlist_evidence",
    "transformation_chain",
    "raw_payload_hash",
    "warrant_confidence",
    "created_at",
    "expires_at",
    "replay_command"
  ],
  "properties": {
    "warrant_id": { "type": "string", "minLength": 1 },
    "seal_id": { "type": ["string", "null"] },
    "candidate_action_id": { "type": "string", "minLength": 1 },
    "decision_id": { "type": "string", "minLength": 1 },
    "system_name": { "type": "string", "minLength": 1 },
    "adapter_name": { "type": "string", "minLength": 1 },
    "adapter_version": { "type": "string", "minLength": 1 },
    "pre_execution": { "type": "boolean" },
    "posthoc": { "type": "boolean" },
    "clearance_score": { "type": "number" },
    "entry_price": { "type": "number" },
    "expected_upside": { "type": "number" },
    "risk_penalty": { "type": "number" },
    "policy_snapshot_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "budget_snapshot_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "jurisdiction_evidence": { "type": "object" },
    "consent_evidence": { "type": "object" },
    "authority_scope": { "type": "string", "minLength": 1 },
    "tool_allowlist_evidence": { "type": "object" },
    "transformation_chain": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "raw_payload_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "warrant_confidence": { "enum": ["native", "inferred", "missing"] },
    "created_at": { "type": "string", "minLength": 1 },
    "expires_at": { "type": "string", "minLength": 1 },
    "replay_command": { "type": ["string", "null"] }
  }
}
