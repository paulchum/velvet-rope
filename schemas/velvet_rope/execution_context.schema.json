{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://velvet.dev/schemas/velvet_rope/execution_context.schema.json",
  "title": "Velvet Rope ExecutionContext",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "execution_id",
    "candidate_action_id",
    "decision_id",
    "warrant_id",
    "seal_id",
    "executed",
    "execution_timestamp",
    "tool_name",
    "tool_namespace",
    "tool_args_hash",
    "tool_args_redacted",
    "side_effect_class",
    "target_resource",
    "state_before_hash",
    "state_after_hash",
    "external_recipient",
    "spend_amount",
    "spend_currency",
    "mutation_type",
    "execution_result_hash",
    "hidden_execution_detected",
    "adapter_notes"
  ],
  "properties": {
    "execution_id": { "type": "string", "minLength": 1 },
    "candidate_action_id": { "type": "string", "minLength": 1 },
    "decision_id": { "type": ["string", "null"] },
    "warrant_id": { "type": ["string", "null"] },
    "seal_id": { "type": ["string", "null"] },
    "executed": { "type": "boolean" },
    "execution_timestamp": { "type": ["string", "null"] },
    "tool_name": { "type": "string", "minLength": 1 },
    "tool_namespace": { "type": "string", "minLength": 1 },
    "tool_args_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "tool_args_redacted": { "type": "object" },
    "side_effect_class": { "type": "string", "minLength": 1 },
    "target_resource": { "type": "string", "minLength": 1 },
    "state_before_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "state_after_hash": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "external_recipient": { "type": ["string", "null"] },
    "spend_amount": { "type": ["number", "null"] },
    "spend_currency": { "type": ["string", "null"] },
    "mutation_type": { "type": "string", "minLength": 1 },
    "execution_result_hash": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "hidden_execution_detected": { "type": "boolean" },
    "adapter_notes": { "type": "string" }
  }
}
