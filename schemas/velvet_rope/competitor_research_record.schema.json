{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://velvet.dev/schemas/velvet_rope/competitor_research_record.schema.json",
  "title": "Velvet Rope CompetitorResearchRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "system_name",
    "category",
    "website_or_repo",
    "docs_checked",
    "examples_checked",
    "source_checked",
    "version_or_date_checked",
    "adapter_feasibility",
    "has_tool_calling",
    "has_mcp_support",
    "has_workflows",
    "has_parallel_execution",
    "has_human_review",
    "has_guardrails",
    "has_observability",
    "has_policy_controls",
    "has_budget_controls",
    "has_consent_controls",
    "has_jurisdiction_controls",
    "has_pre_execution_boundary",
    "emits_candidate_actions",
    "emits_admission_decisions",
    "emits_execution_context",
    "emits_pre_execution_warrant",
    "emits_replay_seal",
    "distinguishes_planned_vs_executed",
    "distinguishes_admitted_vs_executed",
    "distinguishes_refused_vs_executed",
    "can_capture_hidden_tool_calls",
    "can_bind_failures_to_trace_hashes",
    "can_replay_decisions",
    "missing_artifacts",
    "likely_failure_classes",
    "auditability_grade",
    "result_type",
    "public_claim_status",
    "sources_needed",
    "notes"
  ],
  "properties": {
    "system_name": { "type": "string", "minLength": 1 },
    "category": { "type": "string", "minLength": 1 },
    "website_or_repo": { "type": "string", "minLength": 1 },
    "docs_checked": { "type": "array", "items": { "type": "string" } },
    "examples_checked": { "type": "array", "items": { "type": "string" } },
    "source_checked": { "type": "array", "items": { "type": "string" } },
    "version_or_date_checked": { "type": "string", "minLength": 1 },
    "adapter_feasibility": { "type": "string", "minLength": 1 },
    "has_tool_calling": { "type": "boolean" },
    "has_mcp_support": { "type": "boolean" },
    "has_workflows": { "type": "boolean" },
    "has_parallel_execution": { "type": "boolean" },
    "has_human_review": { "type": "boolean" },
    "has_guardrails": { "type": "boolean" },
    "has_observability": { "type": "boolean" },
    "has_policy_controls": { "type": "boolean" },
    "has_budget_controls": { "type": "boolean" },
    "has_consent_controls": { "type": "boolean" },
    "has_jurisdiction_controls": { "type": "boolean" },
    "has_pre_execution_boundary": { "type": "boolean" },
    "emits_candidate_actions": { "type": "boolean" },
    "emits_admission_decisions": { "type": "boolean" },
    "emits_execution_context": { "type": "boolean" },
    "emits_pre_execution_warrant": { "type": "boolean" },
    "emits_replay_seal": { "type": "boolean" },
    "distinguishes_planned_vs_executed": { "type": "boolean" },
    "distinguishes_admitted_vs_executed": { "type": "boolean" },
    "distinguishes_refused_vs_executed": { "type": "boolean" },
    "can_capture_hidden_tool_calls": { "type": "boolean" },
    "can_bind_failures_to_trace_hashes": { "type": "boolean" },
    "can_replay_decisions": { "type": "boolean" },
    "missing_artifacts": { "type": "array", "items": { "type": "string" } },
    "likely_failure_classes": { "type": "array", "items": { "type": "string" } },
    "auditability_grade": { "enum": ["full", "partial", "non_auditable"] },
    "result_type": { "enum": ["live", "fixture", "trace_audit_only", "not_run", "ablation"] },
    "public_claim_status": {
      "enum": ["publishable", "not_claimable", "internal_only", "draft_requires_legal_review"]
    },
    "sources_needed": { "type": "boolean" },
    "notes": { "type": "string" }
  }
}
