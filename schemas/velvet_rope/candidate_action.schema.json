{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://velvet.dev/schemas/velvet_rope/candidate_action.schema.json",
  "title": "Velvet Rope CandidateAction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_action_id",
    "run_id",
    "query_id",
    "system_name",
    "adapter_name",
    "adapter_version",
    "action_type",
    "tool_name",
    "tool_namespace",
    "tool_args_hash",
    "tool_args_redacted",
    "side_effect_class",
    "target_resource",
    "proposed_by",
    "proposal_timestamp",
    "proposal_rank",
    "proposal_score",
    "expected_upside",
    "estimated_cost",
    "estimated_risk",
    "requires_consent",
    "requires_budget",
    "requires_policy_check",
    "requires_human_review",
    "jurisdiction_claim",
    "authority_scope_claim",
    "raw_payload_hash",
    "adapter_notes"
  ],
  "properties": {
    "candidate_action_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "query_id": { "type": "string", "minLength": 1 },
    "system_name": { "type": "string", "minLength": 1 },
    "adapter_name": { "type": "string", "minLength": 1 },
    "adapter_version": { "type": "string", "minLength": 1 },
    "action_type": { "type": "string", "minLength": 1 },
    "tool_name": { "type": "string", "minLength": 1 },
    "tool_namespace": { "type": "string", "minLength": 1 },
    "tool_args_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "tool_args_redacted": { "type": "object" },
    "side_effect_class": { "type": "string", "minLength": 1 },
    "target_resource": { "type": "string", "minLength": 1 },
    "proposed_by": { "type": "string", "minLength": 1 },
    "proposal_timestamp": { "type": "string", "minLength": 1 },
    "proposal_rank": { "type": "integer", "minimum": 1 },
    "proposal_score": { "type": "number" },
    "expected_upside": { "type": "number" },
    "estimated_cost": { "type": "number" },
    "estimated_risk": { "type": "number" },
    "requires_consent": { "type": "boolean" },
    "requires_budget": { "type": "boolean" },
    "requires_policy_check": { "type": "boolean" },
    "requires_human_review": { "type": "boolean" },
    "jurisdiction_claim": { "type": "string", "minLength": 1 },
    "authority_scope_claim": { "type": "string", "minLength": 1 },
    "raw_payload_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "adapter_notes": { "type": "string" }
  }
}
