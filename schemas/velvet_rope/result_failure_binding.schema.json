{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://velvet.dev/schemas/velvet_rope/result_failure_binding.schema.json",
  "title": "Velvet Rope ResultFailureBinding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "binding_id",
    "run_id",
    "system_name",
    "adapter_name",
    "adapter_version",
    "result_type",
    "auditability_status",
    "scenario_id",
    "scenario_fingerprint",
    "query_id",
    "trace_id",
    "trace_hash",
    "candidate_action_id",
    "decision_id",
    "execution_id",
    "warrant_id",
    "seal_id",
    "failure_card_id",
    "failure_class",
    "metric_name",
    "metric_numerator_contribution",
    "severity",
    "liability_multiplier_contribution",
    "public_report_anchor",
    "reproduction_command",
    "created_at"
  ],
  "properties": {
    "binding_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "system_name": { "type": "string", "minLength": 1 },
    "adapter_name": { "type": "string", "minLength": 1 },
    "adapter_version": { "type": "string", "minLength": 1 },
    "result_type": { "enum": ["live", "fixture", "trace_audit_only", "not_run", "ablation"] },
    "auditability_status": { "enum": ["full", "partial", "non_auditable"] },
    "scenario_id": { "type": "string", "minLength": 1 },
    "scenario_fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "query_id": { "type": "string", "minLength": 1 },
    "trace_id": { "type": "string", "minLength": 1 },
    "trace_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "candidate_action_id": { "type": ["string", "null"] },
    "decision_id": { "type": ["string", "null"] },
    "execution_id": { "type": ["string", "null"] },
    "warrant_id": { "type": ["string", "null"] },
    "seal_id": { "type": ["string", "null"] },
    "failure_card_id": { "type": "string", "minLength": 1 },
    "failure_class": { "type": "string", "minLength": 1 },
    "metric_name": { "type": "string", "minLength": 1 },
    "metric_numerator_contribution": { "type": "integer", "minimum": 1 },
    "severity": {
      "enum": ["critical", "high", "medium", "low", "opportunity", "cost"]
    },
    "liability_multiplier_contribution": { "type": "number", "exclusiveMinimum": 0 },
    "public_report_anchor": { "type": "string", "minLength": 1 },
    "reproduction_command": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "minLength": 1 }
  }
}
