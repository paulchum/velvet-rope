---
import "../styles/global.css";
import report from "../../public/proofs/refunds/report.json";
import evidence from "../../public/proofs/refunds/evidence.json";

const result = report.verification;
const money = (cents: number) => new Intl.NumberFormat("en-US", {
  style: "currency", currency: "USD", maximumFractionDigits: 2,
}).format(cents / 100);
const canonicalUrl = new URL("/protected-refunds/", Astro.site ?? Astro.url);
const source = "https://github.com/paulchum/velvet-rope/blob/main/docs/public/protected-refunds.md";
const verifyCommand = `uv run python -m velvet.refunds verify evidence.json \\
  --observer-key observer-public-key.pem \\
  --observer-key-id reference-observer \\
  --contract-hash ${result.contract_hash}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Inspect a real PostgreSQL reference run: exact refund authorization, one shared budget, atomic operation identity, and a signed observer checkpoint you can verify offline." />
    <meta name="theme-color" content="#f4f0e8" />
    <title>Protected refunds — Velvet</title>
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="nav-shell">
        <a class="brand" href="/" aria-label="Velvet home">
          <span class="brand-mark" aria-hidden="true">V/R</span><span>Velvet</span>
        </a>
        <a class="button button-small button-dark" href={source}>Read the contract ↗</a>
      </div>
    </header>
    <main id="main" class="refund-page section-shell">
      <section class="refund-intro" aria-labelledby="title">
        <p class="eyebrow">Protected refunds / PostgreSQL reference</p>
        <h1 id="title">One budget.<br />Concurrent refunds.<br /><span>Verifiable commits.</span></h1>
        <p class="refund-lede">A permit alone cannot account for what other agents have spent.
          This ledger checks the exact authorized refund, order revision, shared budget and workflow
          state inside the same transaction that records the refund.</p>
        <div class="hero-actions">
          <a class="button button-primary" href="#evidence">Inspect the evidence</a>
          <a class="button button-quiet" href={source}>Reproduce from source ↗</a>
        </div>
        <p class="refund-caption">Recorded local PostgreSQL run · Synthetic orders · No payment provider</p>
      </section>

      <section class="refund-panel" aria-labelledby="result-title">
        <div class="refund-panel-heading">
          <div><p class="eyebrow">Closed ledger checkpoint</p><h2 id="result-title">Every committed refund reconciled.</h2></div>
          <span class="refund-status">{result.status}</span>
        </div>
        <div class="refund-metrics">
          <div><strong>{result.committed_refunds}</strong><span>distinct refunds committed</span></div>
          <div><strong>{money(result.spent_cents)}</strong><span>of {money(result.budget_cents)} authorized budget</span></div>
          <div><strong>{result.records_checked}</strong><span>journal records verified</span></div>
          <div><strong>Closed</strong><span>further refunds rejected</span></div>
        </div>
        <p class="refund-caption">Observed <time datetime={report.observed_at}>{report.observed_at}</time>.
          A historical result for this ledger and contract, with the database, executor, authority
          and observer trusted.</p>
      </section>

      <section class="refund-section" aria-labelledby="mechanism">
        <p class="eyebrow">What the boundary does</p>
        <h2 id="mechanism">Check the constraint where the state changes.</h2>
        <ol class="refund-steps">
          <li><span>01</span><h3>Bind the operation</h3><p>An expiring signed permit binds the ledger,
            order, amount, operation ID, expected revision and lifecycle epoch.</p></li>
          <li><span>02</span><h3>Serialize the decision</h3><p>One database lock orders refunds and
            closure. Every new refund sees the budget left by earlier commits.</p></li>
          <li><span>03</span><h3>Commit together</h3><p>The mutation, consumed identity and journal
            entry share one transaction. An identical retry retrieves the existing result.</p></li>
          <li><span>04</span><h3>Reconcile outside the caller</h3><p>A separate database identity
            reads the ledger and journal. Its signed snapshot supports offline verification.</p></li>
        </ol>
      </section>

      <section class="refund-section" aria-labelledby="evidence">
        <div class="refund-panel-heading">
          <div><p class="eyebrow">Actual committed journal</p><h2 id="evidence">Follow each transition.</h2></div>
          <a class="text-link" href="/proofs/refunds/evidence.json" download>Download signed evidence ↓</a>
        </div>
        <div class="refund-journal">
          {evidence.snapshot.records.map(({ event, event_hash }) => (
            <details>
              <summary>
                <span class="refund-sequence">{String(event.sequence).padStart(2, "0")}</span>
                <span>{event.kind === "open" ? "Open ledger" : event.kind === "close" ? "Close workflow" : event.command?.operation_id}</span>
                <strong>{event.command ? money(event.command.amount_cents) : "—"}</strong>
                <span class="refund-expand" aria-hidden="true">+</span>
              </summary>
              <div class="refund-record">
                <p>Decision time <time datetime={event.evaluated_at}>{event.evaluated_at}</time></p>
                {event.command && <p>Order: {event.command.order_id} · Revision: {event.command.revision} · Epoch: {event.command.epoch}</p>}
                <p>Event hash <code>{event_hash}</code></p>
                <p>Resulting state hash <code>{event.state_hash}</code></p>
                {event.permit && <p>Permit <code>{event.permit.permit_id}</code></p>}
              </div>
            </details>
          ))}
        </div>
        <p class="refund-caption">A retry adds no new commit. Budget and post-closure rejections are
          caller observations in the <a href="/proofs/refunds/report.json">workload report</a>;
          the signed journal accounts for committed transitions.</p>
      </section>

      <section class="refund-section refund-verify" aria-labelledby="verify">
        <div><p class="eyebrow">No database needed to verify</p><h2 id="verify">Take the evidence with you.</h2>
          <p>From a source checkout, download the bundle and public key, then run the verifier.
            Pin the key and contract hash through a trusted channel. Embedded keys alone
            are insufficient.</p>
          <div class="refund-downloads">
            <a href="/proofs/refunds/evidence.json" download>Evidence JSON ↓</a>
            <a href="/proofs/refunds/observer-public-key.pem" download>Observer public key ↓</a>
            <a href="/proofs/refunds/contract.sha256" download>Contract hash ↓</a>
          </div>
        </div>
        <pre><code>{verifyCommand}</code></pre>
      </section>

      <section class="refund-section refund-boundary" aria-labelledby="boundary">
        <p class="eyebrow">A precise claim has a boundary</p>
        <h2 id="boundary">What this result establishes.</h2>
        <p>The pinned checkpoint reconciles one closed reference ledger, its operation identities,
          exact-command permits and business invariants. Missing evidence returns <code>INVALID</code>;
          an unclosed workflow returns <code>OPEN_INTERVAL</code>.</p>
        <p>This release includes a state-machine specification, bounded state exploration and
          PostgreSQL conformance tests. It is not a machine-checked proof of a deployment.
          Database owners, the enforcing service and signing keys remain trusted. The sample's
          observer uses a separate database role within the same local process.</p>
        <p>Payment rails, external writes, distributed revocation and automatic discovery of every
          agent route are outside this package. No customer or competitor performance claim is
          implied by this run.</p>
        <a class="text-link" href={source}>Read assumptions, tests and remaining work ↗</a>
      </section>
    </main>
    <footer class="refund-footer section-shell"><a href="/">← Velvet outcome assurance</a><span>Open source · Apache-2.0</span></footer>
  </body>
</html>

<style>
  .refund-page { padding-top: 84px; }
  .refund-intro { max-width: 850px; padding-bottom: 64px; }
  h1 { font-size: clamp(2.7rem, 6.6vw, 5.8rem); line-height: 1.04; letter-spacing: -.055em; margin: 24px 0; }
  h1 span { color: var(--purple); }
  h2 { font-size: clamp(1.6rem, 3vw, 2.35rem); line-height: 1.15; letter-spacing: -.035em; }
  h3 { font-size: 1.1rem; margin: 20px 0 12px; }
  .refund-lede { max-width: 680px; font-size: 1.12rem; color: var(--ink-soft); }
  .refund-caption { font-size: .8rem; margin-top: 24px; overflow-wrap: anywhere; }
  .refund-panel { background: var(--surface); border: 1px solid var(--line); padding: 32px; border-radius: var(--radius); }
  .refund-panel-heading { display: flex; align-items: center; justify-content: space-between; gap: 24px; }
  .refund-panel-heading h2 { margin-top: 12px; }
  .refund-status { font: 700 .75rem monospace; color: #195a40; background: var(--success-soft); padding: 9px 13px; border-radius: 4px; letter-spacing: .08em; }
  .refund-metrics { display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid var(--line); margin-top: 32px; padding-top: 28px; gap: 24px; }
  .refund-metrics div { display: flex; flex-direction: column; gap: 8px; }
  .refund-metrics strong { font-size: clamp(1.8rem, 3vw, 2.6rem); letter-spacing: -.04em; }
  .refund-metrics span { font-size: .8rem; color: var(--muted); }
  .refund-section { padding: 72px 0; border-bottom: 1px solid var(--line); }
  .refund-section > h2 { margin: 16px 0 32px; }
  .refund-steps { display: grid; grid-template-columns: repeat(4, 1fr); list-style: none; padding: 0; margin: 36px 0 0; gap: 28px; }
  .refund-steps li > span { font: .85rem monospace; color: var(--purple); }
  .refund-steps p { font-size: .9rem; }
  .refund-journal { margin-top: 32px; border-top: 1px solid var(--line); }
  details { border-bottom: 1px solid var(--line); }
  summary { display: grid; grid-template-columns: 36px 1fr auto 16px; gap: 16px; padding: 22px 0; cursor: pointer; align-items: center; list-style: none; }
  summary::-webkit-details-marker { display: none; }
  summary:focus-visible { outline: 2px solid var(--purple); outline-offset: 4px; }
  .refund-sequence { font: .8rem monospace; color: var(--muted); }
  .refund-expand { color: var(--purple); }
  details[open] .refund-expand { transform: rotate(45deg); }
  .refund-record { padding: 0 0 24px 52px; }
  .refund-record p { font-size: .85rem; margin: 8px 0; overflow-wrap: anywhere; }
  .refund-record code { display: block; color: var(--ink-soft); font-size: .75rem; }
  .refund-verify { display: grid; grid-template-columns: .85fr 1.15fr; gap: 40px; align-items: start; }
  .refund-verify h2 { margin: 16px 0 24px; }
  .refund-verify p, .refund-boundary p { color: var(--ink-soft); }
  .refund-downloads { display: flex; flex-wrap: wrap; gap: 16px; margin-top: 24px; font-size: .8rem; color: var(--purple-deep); }
  pre { margin: 0; background: var(--night); color: var(--purple-soft); border-radius: var(--radius); padding: 24px; font-size: .8rem; line-height: 1.9; white-space: pre-wrap; overflow-wrap: anywhere; min-width: 0; }
  .refund-boundary { max-width: 800px; border: none; }
  .refund-boundary p { margin-bottom: 20px; }
  .refund-footer { display: flex; justify-content: space-between; padding-top: 28px; padding-bottom: 40px; border-top: 1px solid var(--line); font-size: .8rem; gap: 24px; }
  @media (max-width: 760px) {
    .refund-page { padding-top: 40px; }
    .refund-panel { padding: 24px; }
    .refund-panel-heading { align-items: start; flex-direction: column; }
    .refund-metrics, .refund-steps { grid-template-columns: repeat(2, 1fr); }
    .refund-verify { grid-template-columns: 1fr; }
    .refund-section { padding: 48px 0; }
    .refund-record { padding-left: 0; }
  }
</style>
